# Copy to .env and fill in. Never commit real values.

# Token required to trigger collections via POST /api/collect/now
# (X-Api-Token header). Server returns 503 if unset.
FINOPS_API_TOKEN=change-me

# Optional: GitHub token for higher GitHub API rate limits in collectors
# (read from GH_TOKEN env var; leave empty for unauthenticated 10 req/min search API).
GH_TOKEN=

# Optional server overrides (defaults: 127.0.0.1:8000 from config.yaml)
# FINOPS_HOST=127.0.0.1
# FINOPS_PORT=8000
